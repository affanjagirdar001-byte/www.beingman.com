<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>For Tejaswini ✦</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="style.css">
</head>

<body>

  <!-- PRELOADER -->
  <div id="preloader">
    <div class="loader"></div>
    <p>Preparing something special...</p>
  </div>

  <!-- BACKGROUND -->
  <canvas id="particles"></canvas>
  <canvas id="petals"></canvas>

  <!-- INTRO -->
  <section id="intro">

    <div class="intro-content">

      <div class="eyebrow">A PRIVATE LITTLE MOMENT</div>

      <h1>
        A Little Surprise
        <span>For You</span>
      </h1>

      <p class="subtitle">
        Something special is waiting for you.
      </p>

      <button id="revealBtn">
        <span>Click Me</span>
      </button>

    </div>

  </section>


  <!-- BIRTHDAY -->
  <section id="birthday">

    <div class="birthday-content">

      <p class="eyebrow reveal">
        TODAY IS YOUR DAY
      </p>

      <h2 class="birthday-title reveal">
        <span>Happy Birthday</span>
        <strong>TEJASWINI</strong>
      </h2>


      <!-- PHOTO -->
      <div class="photo-frame reveal">

        <div class="frame-border"></div>

        <div class="photo-container">

          <img
            src="assets/tejaswini.jpg"
            alt="Tejaswini"
            id="birthdayPhoto"
          >

          <div class="photo-light"></div>

          <div class="photo-placeholder">
            <span>YOUR PHOTO</span>
            <small>assets/tejaswini.jpg</small>
          </div>

        </div>

        <p class="caption">
          A memory made beautiful
        </p>

      </div>


      <!-- MESSAGE -->
      <div class="message reveal">

        <h3>
          Happy Birthday, Tejaswini.
        </h3>

        <p>
          May your days be filled with beautiful moments,
          peace, happiness, and countless reasons to smile.
        </p>

        <small>
          TODAY IS ALL ABOUT CELEBRATING YOU.
        </small>

      </div>


      <!-- ENDING -->
      <div class="ending reveal">

        <p>
          Keep smiling.<br>
          Keep shining.<br>
          And keep being you.
        </p>

        <div class="ending-line"></div>

        <strong>
          Happy Birthday, TEJASWINI.
        </strong>

      </div>


      <footer>
        WITH A LITTLE EXTRA MAGIC ✦
      </footer>

    </div>

  </section>


  <!-- MUSIC -->
  <button id="musicBtn" aria-label="Music">
    ♪
  </button>

  <audio
    id="music"
    src="assets/birthday-music.mp3"
    loop
  ></audio>


  <script src="script.js"></script>

